---
import { getCollection } from 'astro:content';
import { entryUrl, url } from '../lib/tutorials';
import { getLang, langOfId, t } from '../lib/i18n';

const lang = getLang(Astro);
const pre = lang === 'ko' ? 'ko/' : '';

// astro.config.mjs 사이드바와 같은 순서로 묶음을 보여 준다. 모바일 홈에는 사이드바가 없어서 만든 전체 목차.
const all = await getCollection('docs');
const byDir = (dir: string) =>
  all
    .filter((e) => e.id.startsWith(pre + dir + '/') && e.id !== `${pre}${dir}/index`)
    .sort((a, b) => (a.data.sidebar?.order ?? 999) - (b.data.sidebar?.order ?? 999) || a.id.localeCompare(b.id));
const chips = (dir: string) => byDir(dir).map((e) => ({ label: e.data.sidebar?.label ?? e.data.title, href: entryUrl(e.id) }));

const L = (label: string, path: string) => ({ label, href: url(path, lang) });

// 사이드바 6개 묶음과 같은 구성. 칩은 콘텐츠 컬렉션에서 가져와 항상 최신 상태를 유지한다.
const sections = (items: { title: string; dir: string }[]) =>
  items.map((s) => ({ title: s.title, href: url(`/${s.dir}/`, lang), chips: chips(s.dir) }));

const groups: { title: string; href?: string; chips?: { label: string; href: string }[]; subs?: { title: string; href: string; chips: { label: string; href: string }[] }[] }[] = [
  { title: t(lang, 'toc.start'), chips: [
    L(t(lang, 'toc.beginner'), '/start/beginner/'), L(t(lang, 'toc.practical'), '/start/practical/'),
    L(t(lang, 'toc.advanced'), '/start/advanced/'), L(t(lang, 'toc.rolesGuide'), '/roles/'),
  ] },
  { title: t(lang, 'cat.basics'), href: url('/basics/', lang), chips: chips('basics') },
  { title: t(lang, 'cat.claude'), href: url('/claude/', lang), chips: [L(t(lang, 'toc.news'), '/claude-news/'), ...chips('claude')] },
  { title: t(lang, 'toc.fields'), subs: sections([
    { title: t(lang, 'cat.chat'), dir: 'chat' },
    { title: t(lang, 'cat.coding'), dir: 'coding' },
    { title: t(lang, 'cat.media'), dir: 'media' },
    { title: t(lang, 'cat.automation'), dir: 'automation' },
    { title: t(lang, 'cat.agents'), dir: 'agents' },
    { title: t(lang, 'cat.dev'), dir: 'dev' },
  ]) },
  { title: t(lang, 'cc.roles'), href: url('/roles/', lang), chips: chips('roles') },
  { title: t(lang, 'toc.ref'), chips: [
    L(t(lang, 'toc.prompts'), '/start/prompts/'), L(t(lang, 'toc.glossary'), '/start/glossary/'),
    L(t(lang, 'toc.all'), '/tutorials/'), L(t(lang, 'toc.updates'), '/updates/'), L(t(lang, 'toc.about'), '/about/'),
  ] },
];
---
<div class="toc not-content">
  {groups.map((g) => (
    <section class:list={['grp', { wide: g.subs }]}>
      <h3>{g.href ? <a href={g.href}>{g.title}</a> : g.title}</h3>
      {g.chips && (g.chips.length > 6 ? (
        <details class="fold" open>
          <summary>{t(lang, 'toc.show', { n: g.chips.length })}</summary>
          <ul>{g.chips.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
        </details>
      ) : (
        <ul>{g.chips.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
      ))}
      {g.subs && (
        <div class="subs">
          {g.subs.map((s) => (
            <div class="sub">
              <h4><a href={s.href}>{s.title}</a></h4>
              <details class="fold" open>
                <summary>{t(lang, 'toc.show', { n: s.chips.length })}</summary>
                <ul>{s.chips.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
              </details>
            </div>
          ))}
        </div>
      )}
    </section>
  ))}
</div>

<style>
  .toc { display: grid; gap: 0.875rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); align-items: start; }
  .grp { padding: 1rem 1.1rem 1.1rem; border-radius: var(--ai-radius-lg); background: var(--ai-surface); border: 1px solid var(--ai-line); }
  .grp.wide { grid-column: 1 / -1; }
  h3 { margin: 0; font-size: var(--sl-text-sm); font-weight: 650; color: var(--sl-color-white); letter-spacing: -0.005em; }
  h4 { margin: 0; font-size: var(--sl-text-sm); font-weight: 600; }
  h3 a, h4 a { color: var(--sl-color-white); text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem; }
  h3 a:hover, h4 a:hover { color: var(--ai-coral-ink); }
  h3 a::after, h4 a::after { content: '\2192'; font-weight: 400; color: var(--sl-color-gray-4); transition: color 0.15s; }
  h3 a:hover::after, h4 a:hover::after { color: var(--ai-coral-ink); }
  .subs { display: grid; gap: 1rem 1.5rem; margin-top: 0.75rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); align-items: start; }
  .sub { padding-top: 0.75rem; border-top: 1px solid var(--ai-line); }
  summary { cursor: pointer; margin-top: 0.4rem; padding: 0.1rem 0; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); list-style: none; display: inline-flex; align-items: center; gap: 0.3rem; }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: ''; width: 0.4rem; height: 0.4rem; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(-45deg); transition: transform 0.15s; margin-right: 0.1rem; }
  details[open] > summary::before { transform: rotate(45deg); }
  summary:hover { color: var(--sl-color-white); }
  ul { list-style: none; margin: 0.6rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  li { margin: 0; padding: 0; }
  li a {
    display: inline-block; padding: 0.2rem 0.6rem; border-radius: var(--ai-radius-sm); font-size: var(--sl-text-xs); line-height: 1.5;
    text-decoration: none; color: var(--sl-color-gray-2); background: var(--ai-surface-2); border: 1px solid var(--ai-line);
    transition: border-color 0.15s, color 0.15s, background-color 0.15s;
  }
  li a:hover { border-color: var(--ai-line-strong); color: var(--sl-color-white); background: var(--ai-surface); }
</style>

<script>
  // JS가 없으면 모두 펼쳐진 채로 보이고, 좁은 화면에서는 접어서 시작한다.
  if (matchMedia('(max-width: 63.99rem)').matches) {
    document.querySelectorAll<HTMLDetailsElement>('.toc details.fold').forEach((d) => (d.open = false));
  }
</script>
