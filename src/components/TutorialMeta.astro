---
import LevelBadge from './LevelBadge.astro';
import { getCategoryLabel, formatDate, type Level, type Category } from '../lib/tutorials';
import { getLang, t } from '../lib/i18n';
interface Props {
  level?: Level; category?: Category; duration?: string;
  prerequisites?: string[]; tools?: string[]; lastVerified?: Date; status?: 'draft' | 'published';
}
const { level, category, duration, prerequisites = [], tools = [], lastVerified, status = 'draft' } = Astro.props;
const lang = getLang(Astro);
---
<aside class="meta not-content" aria-label={t(lang, 'meta.label')}>
  <div class="row">
    {level && <LevelBadge level={level} />}
    {category && <span class="chip">{getCategoryLabel(category, lang)}</span>}
    {status === 'draft' && <span class="chip draft">{t(lang, 'meta.draft')}</span>}
  </div>
  <dl>
    <div><dt>{t(lang, 'meta.duration')}</dt><dd>{duration ?? t(lang, 'meta.tbd')}</dd></div>
    <div><dt>{t(lang, 'meta.verified')}</dt><dd>{lastVerified ? formatDate(lastVerified, lang) : t(lang, 'sources.notYet')}</dd></div>
    {tools.length > 0 && <div><dt>{t(lang, 'meta.tools')}</dt><dd>{tools.join(', ')}</dd></div>}
    {prerequisites.length > 0 && (
      <div class="wide"><dt>{t(lang, 'meta.prereq')}</dt><dd><ul>{prerequisites.map((p) => <li>{p}</li>)}</ul></dd></div>
    )}
  </dl>
</aside>

<style>
  .meta {
    margin: 1rem 0 1.5rem; padding: 0.9rem 1.1rem;
    border: 1px solid var(--ai-line); border-radius: var(--ai-radius);
    background: var(--ai-surface-2);
  }
  .row { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.75rem; }
  .chip {
    display: inline-flex; align-items: center; padding: 0.1rem 0.5rem; border-radius: var(--ai-radius-sm); font-size: var(--sl-text-2xs); font-weight: 600; line-height: 1.6;
    background: var(--ai-surface); color: var(--sl-color-gray-2); border: 1px solid var(--ai-line);
  }
  .chip.draft { background: var(--ai-yellow-bg); color: var(--ai-yellow-fg); border-color: transparent; }
  dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr)); gap: 0.6rem 1.5rem; margin: 0; }
  dl > div { min-width: 0; }
  .wide { grid-column: 1 / -1; }
  dt { font-size: var(--sl-text-2xs); font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--sl-color-gray-3); }
  dd { margin: 0.15rem 0 0; font-size: var(--sl-text-sm); color: var(--sl-color-white); overflow-wrap: anywhere; }
  ul { margin: 0; padding-left: 1.1rem; }
  li { margin: 0.1rem 0; }
</style>
