---
import Illustration from './Illustration.astro';
import { url } from '../lib/tutorials';
const levels = [
  { key: 'beginner', title: '입문', desc: 'AI가 처음이에요. 기본 개념과 첫걸음부터 알고 싶어요.', href: '/start/beginner/' },
  { key: 'practical', title: '실무', desc: '업무에 AI를 써 보고 싶어요. 바로 따라 할 수 있는 활용법이 필요해요.', href: '/start/practical/' },
  { key: 'advanced', title: '고급', desc: '더 깊이 다루고 싶어요. API, Agent SDK, MCP, CI 자동화까지 가 볼래요.', href: '/start/advanced/' },
] as const;
---
<ul class="levels not-content">
  {levels.map((l) => (
    <li>
      <a href={url(l.href)} class={`lv lv-${l.key}`}>
        <Illustration name={l.key} size={56} />
        <h3>{l.title}</h3>
        <p>{l.desc}</p>
        <span class="go">여기서 시작하기 →</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .levels { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  li { margin: 0; padding: 0; }
  .lv {
    display: flex; flex-direction: column; gap: 0.35rem; height: 100%; padding: 1.25rem; border-radius: 18px;
    text-decoration: none; border: 2px solid transparent; box-shadow: var(--ai-shadow); transition: transform 0.15s;
  }
  .lv:hover { transform: translateY(-3px); }
  .lv-beginner { background: var(--ai-green-bg); }
  .lv-practical { background: var(--ai-blue-bg); }
  .lv-advanced { background: var(--ai-purple-bg); }
  h3 { margin: 0.3rem 0 0; font-size: var(--sl-text-h3); font-weight: 800; }
  .lv-beginner h3, .lv-beginner .go { color: var(--ai-green-fg); }
  .lv-practical h3, .lv-practical .go { color: var(--ai-blue-fg); }
  .lv-advanced h3, .lv-advanced .go { color: var(--ai-purple-fg); }
  p { margin: 0; color: var(--sl-color-white); line-height: 1.55; }
  .go { margin-top: auto; padding-top: 0.5rem; font-weight: 700; }
</style>
