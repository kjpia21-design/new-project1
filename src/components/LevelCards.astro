---
import Illustration from './Illustration.astro';
import { url, getLevelLabel } from '../lib/tutorials';
import { getLang, t } from '../lib/i18n';
const lang = getLang(Astro);
const levels = [
  { key: 'beginner', tone: 'green', title: getLevelLabel('beginner', lang), desc: t(lang, 'lv.beginner.desc'), href: '/start/beginner/' },
  { key: 'practical', tone: 'blue', title: getLevelLabel('practical', lang), desc: t(lang, 'lv.practical.desc'), href: '/start/practical/' },
  { key: 'advanced', tone: 'purple', title: getLevelLabel('advanced', lang), desc: t(lang, 'lv.advanced.desc'), href: '/start/advanced/' },
] as const;
---
<ul class="levels not-content">
  {levels.map((l, i) => (
    <li>
      <a href={url(l.href, lang)} class={`lv lv-${l.key}`}>
        <div class="top">
          <Illustration name={l.key} size={40} tone={l.tone} />
          <span class="step" aria-hidden="true">0{i + 1}</span>
        </div>
        <h3>{l.title}</h3>
        <p>{l.desc}</p>
        <span class="go">{t(lang, 'lv.go')}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .levels { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  li { margin: 0; padding: 0; }
  .lv {
    position: relative; overflow: hidden;
    display: flex; flex-direction: column; gap: 0.4rem; height: 100%; padding: 1.35rem 1.35rem 1.2rem;
    border-radius: var(--ai-radius-lg); text-decoration: none;
    background: var(--ai-surface); border: 1px solid var(--ai-line); box-shadow: var(--ai-shadow);
    transition: border-color 0.15s, box-shadow 0.2s var(--ai-ease), transform 0.2s var(--ai-ease);
  }
  .lv::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 3px; background: var(--tone); opacity: 0; transition: opacity 0.2s; }
  .lv-beginner { --tone: var(--sl-color-green); }
  .lv-practical { --tone: var(--sl-color-blue); }
  .lv-advanced { --tone: var(--sl-color-purple); }
  .lv:hover { border-color: var(--ai-line-strong); box-shadow: var(--ai-shadow-md); transform: translateY(-2px); }
  .lv:hover::before, .lv:focus-visible::before { opacity: 1; }
  .top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.7rem; }
  .step { font-size: var(--sl-text-xs); font-weight: 600; letter-spacing: 0.06em; color: var(--sl-color-gray-3); font-variant-numeric: tabular-nums; }
  h3 { margin: 0; font-size: 1.15rem; font-weight: 700; color: var(--sl-color-white); letter-spacing: -0.015em; }
  p { margin: 0; font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); line-height: 1.6; }
  .go { margin-top: auto; padding-top: 1rem; display: inline-flex; align-items: center; gap: 0.3rem; font-size: var(--sl-text-sm); font-weight: 600; color: var(--ai-coral-ink); }
  @media (max-width: 40rem) {
    /* 휴대폰: 아이콘을 왼쪽에 두는 가로형 카드로 높이를 줄인다. */
    .levels { gap: 0.75rem; }
    .lv { display: grid; grid-template-columns: auto 1fr; column-gap: 0.9rem; row-gap: 0.2rem; padding: 1rem 1.1rem; }
    .top { grid-row: 1 / span 3; align-self: start; margin: 0; }
    .step { display: none; }
    .go { padding-top: 0.35rem; }
  }
</style>
