---
// 외부 이미지 없이 쓰는 인라인 SVG 아이콘 모음. 모두 같은 선 굵기(1.75)의 라인 아이콘으로 통일한다.
// `tone`으로 아이콘 색을 고른다(기본: 코랄). 단독으로 쓰면 둥근 타일 위에 놓인다.
interface Props {
  name: 'claude' | 'chat' | 'coding' | 'media' | 'automation' | 'agents' | 'dev' | 'basics' | 'robot' | 'sparkle' | 'beginner' | 'practical' | 'advanced';
  size?: number;
  tone?: 'coral' | 'green' | 'blue' | 'purple' | 'neutral';
  /** true면 타일 배경 없이 아이콘만 그린다 */
  bare?: boolean;
}
const { name, size = 40, tone = 'coral', bare = false } = Astro.props;
const icon = size * 0.55;
---
<span class:list={['illu', `tone-${tone}`, { bare }]} style={`--s:${size}px; --i:${icon}px`} aria-hidden="true">
  <svg width={icon} height={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" focusable="false">
    {(name === 'claude' || name === 'sparkle') && (
      <path d="M12 3.5l2.2 6.3L20.5 12l-6.3 2.2L12 20.5l-2.2-6.3L3.5 12l6.3-2.2z" />
    )}
    {name === 'chat' && (<>
      <path d="M20 12a8 8 0 0 1-11.7 7.1L4 20.5l1.4-4.3A8 8 0 1 1 20 12z" />
      <path d="M8.5 12h.01M12 12h.01M15.5 12h.01" stroke-width="2.4" />
    </>)}
    {name === 'coding' && (<path d="M8 8l-4 4 4 4M16 8l4 4-4 4M14 5l-4 14" />)}
    {name === 'media' && (<>
      <rect x="3" y="5" width="18" height="14" rx="2.5" />
      <circle cx="9" cy="10" r="1.6" />
      <path d="M21 15.5l-4.5-4-6.5 7.5" />
    </>)}
    {name === 'automation' && (<path d="M13 2.5L4.5 13.5H11l-1 8 8.5-11H12l1-8z" />)}
    {name === 'agents' && (<>
      <rect x="4" y="8.5" width="16" height="11" rx="3" />
      <path d="M12 8.5V4.5M9.5 4.5h5M2.5 13v3M21.5 13v3" />
      <path d="M9 14h.01M15 14h.01" stroke-width="2.4" />
    </>)}
    {name === 'dev' && (<>
      <rect x="3" y="4.5" width="18" height="15" rx="2.5" />
      <path d="M7 9.5l3 3-3 3M13 15.5h4" />
    </>)}
    {(name === 'basics' || name === 'beginner') && (<>
      <path d="M12 21v-8.5" />
      <path d="M12 12.5C12 8.5 9 6 4.5 6c0 4.5 3 7 7.5 6.5z" />
      <path d="M12 10.5c0-3.5 2.5-6 7.5-6 0 3.5-2.5 6.5-7.5 6.5z" />
    </>)}
    {(name === 'robot' || name === 'practical') && (<>
      <rect x="3" y="7" width="18" height="13" rx="2.5" />
      <path d="M8.5 7V5.5a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2V7M3 12.5h18" />
    </>)}
    {name === 'advanced' && (<>
      <path d="M12 3l8.5 4.5L12 12 3.5 7.5 12 3z" />
      <path d="M3.5 12l8.5 4.5 8.5-4.5M3.5 16.5L12 21l8.5-4.5" />
    </>)}
  </svg>
</span>

<style>
  .illu {
    display: inline-flex; align-items: center; justify-content: center; flex: none;
    width: var(--s); height: var(--s); border-radius: var(--ai-radius-sm);
    background: var(--tile-bg); color: var(--tile-fg);
    --tile-bg: var(--ai-coral-soft); --tile-fg: var(--ai-coral-ink);
  }
  .illu.bare { background: none; width: var(--i); height: var(--i); border-radius: 0; }
  .tone-green { --tile-bg: var(--ai-green-bg); --tile-fg: var(--ai-green-fg); }
  .tone-blue { --tile-bg: var(--ai-blue-bg); --tile-fg: var(--ai-blue-fg); }
  .tone-purple { --tile-bg: var(--ai-purple-bg); --tile-fg: var(--ai-purple-fg); }
  .tone-neutral { --tile-bg: var(--sl-color-gray-6); --tile-fg: var(--sl-color-gray-1); }
  svg { display: block; }
</style>
