---
import Illustration from './Illustration.astro';
import { url, getTutorials } from '../lib/tutorials';
import { getLang, t } from '../lib/i18n';
const lang = getLang(Astro);
const counts = Object.fromEntries(
  await Promise.all(['basics'].map(async (k) => [k, (await getTutorials({ category: k as 'basics', lang })).length])),
) as Record<string, number>;
const cats = [
  { key: 'robot', title: t(lang, 'cc.roles'), desc: t(lang, 'cc.roles.desc'), href: '/roles/' },
  { key: 'basics', title: t(lang, 'cat.basics'), desc: t(lang, 'cc.basics.desc', { n: counts.basics }), href: '/basics/' },
  { key: 'agents', title: t(lang, 'cat.agents'), desc: t(lang, 'cc.agents.desc'), href: '/agents/' },
  { key: 'dev', title: t(lang, 'cat.dev'), desc: t(lang, 'cc.dev.desc'), href: '/dev/' },
  { key: 'chat', title: t(lang, 'cat.chat'), desc: t(lang, 'cc.chat.desc'), href: '/chat/' },
  { key: 'coding', title: t(lang, 'cat.coding'), desc: t(lang, 'cc.coding.desc'), href: '/coding/' },
  { key: 'media', title: t(lang, 'cat.media'), desc: t(lang, 'cc.media.desc'), href: '/media/' },
  { key: 'automation', title: t(lang, 'cat.automation'), desc: t(lang, 'cc.automation.desc'), href: '/automation/' },
] as const;
---
<ul class="cats not-content">
  {cats.map((c) => (
    <li>
      <a href={url(c.href, lang)}>
        <Illustration name={c.key} size={36} tone="neutral" />
        <div><h3>{c.title}</h3><p>{c.desc}</p></div>
      </a>
    </li>
  ))}
</ul>

<style>
  .cats {
    list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
  }
  li { margin: 0; padding: 0; }
  a {
    display: flex; align-items: flex-start; gap: 0.9rem; height: 100%; padding: 1.05rem 1.1rem; text-decoration: none;
    background: var(--ai-surface); border: 1px solid var(--ai-line); border-radius: var(--ai-radius);
    transition: border-color 0.15s, box-shadow 0.2s var(--ai-ease), transform 0.2s var(--ai-ease);
  }
  a:hover { border-color: var(--ai-line-strong); box-shadow: var(--ai-shadow-md); transform: translateY(-1px); }
  a:hover :global(.illu) { color: var(--ai-coral-ink); background: var(--ai-coral-soft); }
  a :global(.illu) { transition: background-color 0.15s, color 0.15s; }
  a > div { min-width: 0; }
  h3 { margin: 0.05rem 0 0; font-size: var(--sl-text-base); line-height: 1.4; font-weight: 650; color: var(--sl-color-white); letter-spacing: -0.01em; }
  p { margin: 0.25rem 0 0; font-size: var(--sl-text-xs); color: var(--sl-color-gray-2); line-height: 1.55; }
  @media (max-width: 40rem) { .cats { gap: 0.5rem; } a { padding: 0.9rem 1rem; } }
</style>
