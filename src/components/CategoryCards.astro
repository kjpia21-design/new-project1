---
import Illustration from './Illustration.astro';
import { url, getTutorials } from '../lib/tutorials';
import { getLang, t } from '../lib/i18n';
const lang = getLang(Astro);
const counts = Object.fromEntries(
  await Promise.all(['basics'].map(async (k) => [k, (await getTutorials({ category: k as 'basics', lang })).length])),
) as Record<string, number>;
const cats = [
  { key: 'robot', title: t(lang, 'cc.roles'), desc: t(lang, 'cc.roles.desc'), href: '/roles/' },
  { key: 'basics', title: t(lang, 'cat.basics'), desc: t(lang, 'cc.basics.desc', { n: counts.basics }), href: '/basics/' },
  { key: 'agents', title: t(lang, 'cat.agents'), desc: t(lang, 'cc.agents.desc'), href: '/agents/' },
  { key: 'dev', title: t(lang, 'cat.dev'), desc: t(lang, 'cc.dev.desc'), href: '/dev/' },
  { key: 'chat', title: t(lang, 'cat.chat'), desc: t(lang, 'cc.chat.desc'), href: '/chat/' },
  { key: 'coding', title: t(lang, 'cat.coding'), desc: t(lang, 'cc.coding.desc'), href: '/coding/' },
  { key: 'media', title: t(lang, 'cat.media'), desc: t(lang, 'cc.media.desc'), href: '/media/' },
  { key: 'automation', title: t(lang, 'cat.automation'), desc: t(lang, 'cc.automation.desc'), href: '/automation/' },
] as const;
---
<ul class="cats not-content">
  {cats.map((c) => (
    <li>
      <a href={url(c.href, lang)}>
        <Illustration name={c.key} size={52} />
        <div><h3>{c.title}</h3><p>{c.desc}</p></div>
      </a>
    </li>
  ))}
</ul>

<style>
  .cats { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  li { margin: 0; padding: 0; }
  a {
    display: flex; align-items: center; gap: 1rem; height: 100%; padding: 1rem 1.2rem; border-radius: 16px; text-decoration: none;
    background: var(--ai-card); border: 1px solid var(--sl-color-gray-5); box-shadow: var(--ai-shadow); transition: transform 0.15s, border-color 0.15s;
  }
  a:hover { transform: translateY(-2px); border-color: var(--ai-coral); }
  h3 { margin: 0; font-size: var(--sl-text-base); font-weight: 700; color: var(--sl-color-white); }
  p { margin: 0.15rem 0 0; font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); line-height: 1.5; }
</style>
