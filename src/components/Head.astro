---
// Starlight 기본 Head 오버라이드: 기본 <head> 태그를 그대로 내보낸 뒤 소셜 미리보기·theme-color를 덧붙인다.
import Default from '@astrojs/starlight/components/Head.astro';
import { getLang, t } from '../lib/i18n';

const lang = getLang(Astro);
const SITE_NAME = t(lang, 'site.name');
// public/og/<id>.png 로 만들어지는 섹션 이미지 (scripts/og-images.mjs의 SECTIONS와 같게 유지)
const SECTION_NAMES_KO: Record<string, string> = {
  basics: 'AI 첫걸음',
  claude: 'Claude 완전 정복',
  'claude-news': 'Claude 최신 소식',
  agents: '화제의 AI 에이전트',
  dev: '개발자 심화',
  chat: '대화형 AI 기본기',
  coding: '코딩·에이전트',
  media: '이미지·영상·음성',
  automation: '업무 자동화·생산성',
};

const SECTION_NAMES_EN: Record<string, string> = {
  basics: 'AI First Steps',
  claude: 'Mastering Claude',
  'claude-news': 'Claude news',
  agents: 'Trending AI Agents',
  dev: 'Advanced for Developers',
  chat: 'Chat AI Basics',
  coding: 'Coding & Agents',
  media: 'Image, Video & Voice',
  automation: 'Automation & Productivity',
};
const SECTION_NAMES = lang === 'en' ? SECTION_NAMES_EN : SECTION_NAMES_KO;

const { entry } = Astro.locals.starlightRoute;
// 한국어 문서 id는 `ko/...`로 시작하므로 접두사를 떼고 섹션을 찾는다.
const first = entry.id.replace(/^ko\//, '').split('/')[0];
// 문서 폴더(id) 우선, 없으면 frontmatter category, 그것도 없으면 사이트 기본 이미지
const key = first in SECTION_NAMES ? first : entry.data.category && entry.data.category in SECTION_NAMES ? entry.data.category : 'default';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// 언어별 이미지: 영어 /og/<key>.png, 한국어 /og/ko/<key>.png (scripts/og-images.mjs가 두 벌을 생성)
const imageUrl = new URL(`${base}/og/${lang === 'ko' ? 'ko/' : ''}${key}.png`, Astro.site).href;
const imageAlt = key === 'default' ? SITE_NAME : `${SITE_NAME} - ${SECTION_NAMES[key]}`;
---

<Default><slot /></Default>
{/* og:locale은 src/routeMiddleware.ts에서 ko_KR/en_US 형식으로 출력한다. */}
{/*
  첫 방문 언어 안내: 홈(`/`, 영어)에서만, 브라우저 언어에 한국어가 있으면 `/ko/`로 보낸다.
  - localStorage['lang-pref']('ko'|'en')가 있으면 그 선택을 따른다.
  - 검색엔진·미리보기 봇은 이동시키지 않는다. 깊은 페이지는 절대 이동시키지 않는다.
  자세한 규칙은 docs/guides/english-site.md 참고.
*/}
<script is:inline>
  (function () {
    try {
      if (location.pathname !== '/') return;
      if (/bot|crawl|spider|slurp|bingpreview|facebookexternalhit|kakaotalk-scrap|yeti/i.test(navigator.userAgent)) return;
      var pref = null;
      try { pref = localStorage.getItem('lang-pref'); } catch (e) {}
      var goKo;
      if (pref === 'ko') goKo = true;
      else if (pref === 'en') goKo = false;
      else {
        var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
        goKo = Array.prototype.some.call(langs, function (l) { return /^ko/i.test(l); });
      }
      if (goKo) location.replace('/ko/' + location.search + location.hash);
    } catch (e) {}
  })();
</script>
<script is:inline>
  // 언어 선택기로 고른 언어를 기억한다(홈 첫 방문 이동 판단에 사용).
  document.addEventListener('change', function (e) {
    var el = e.target;
    if (!el || el.tagName !== 'SELECT' || !el.closest || !el.closest('starlight-lang-select')) return;
    try { localStorage.setItem('lang-pref', /^\/ko(\/|$)/.test(el.value) ? 'ko' : 'en'); } catch (err) {}
  }, true);
</script>
<meta name="theme-color" content="#fcfbfa" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#121110" media="(prefers-color-scheme: dark)" />
{/* 검색 엔진 소유 확인. 구글은 Cloudflare DNS의 TXT 레코드로 확인했으므로 태그가 필요 없다. 자세한 방법은 docs/guides/search-registration.md 참고. */}
<meta name="naver-site-verification" content="9ee5b97dd724c7af3550e14d997fd821609fb721" />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
