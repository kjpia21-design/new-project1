---
import { url } from '../lib/tutorials';
import { getLang, t } from '../lib/i18n';
interface Props {
  date: string;
  channel: 'API' | 'Claude Code' | 'Claude 앱' | '뉴스' | 'Claude app' | 'News';
  href: string;
  sourceLabel?: string;
  tutorial?: string;
  tutorialLabel?: string;
}
const { date, channel, href, sourceLabel, tutorial, tutorialLabel } = Astro.props;
const lang = getLang(Astro);
const tone = { API: 'blue', 'Claude Code': 'purple', 'Claude 앱': 'green', 'Claude app': 'green', 뉴스: 'yellow', News: 'yellow' }[channel];
const channelLabel = lang === 'en' ? ({ 'Claude 앱': 'Claude app', 뉴스: 'News' } as Record<string, string>)[channel] ?? channel : channel;
// 이미 /ko/ 로 시작하는 경로는 그대로 두고, 아니면 현재 언어 접두사를 붙인다.
const tutorialHref = tutorial ? (tutorial.startsWith('/ko/') ? url(tutorial) : url(tutorial, lang)) : undefined;
---
<article class="news not-content">
  <header>
    <time>{date}</time>
    <span class={`badge ${tone}`}>{channelLabel}</span>
  </header>
  <div class="body"><slot /></div>
  <p class="links">
    <a href={href} target="_blank" rel="noopener noreferrer">{sourceLabel ?? t(lang, 'news.source')} ↗</a>
    {tutorialHref && <a class="tut" href={tutorialHref}>{tutorialLabel ?? t(lang, 'news.tutorial')} →</a>}
  </p>
</article>

<style>
  .news {
    background: var(--ai-surface); border: 1px solid var(--ai-line);
    border-radius: var(--ai-radius); padding: 0.85rem 1.1rem; margin: 0 0 0.75rem;
  }
  header { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  time { font-weight: 600; color: var(--sl-color-gray-2); font-size: var(--sl-text-xs); font-variant-numeric: tabular-nums; }
  .badge { font-size: var(--sl-text-2xs); font-weight: 600; padding: 0.05rem 0.5rem; border-radius: var(--ai-radius-sm); }
  .blue { background: var(--ai-blue-bg); color: var(--ai-blue-fg); }
  .purple { background: var(--ai-purple-bg); color: var(--ai-purple-fg); }
  .green { background: var(--ai-green-bg); color: var(--ai-green-fg); }
  .yellow { background: var(--ai-yellow-bg); color: var(--ai-yellow-fg); }
  p { margin: 0; }
  .body :global(p) { margin: 0; }
  .body { margin-top: 0.4rem; line-height: 1.65; font-size: var(--sl-text-sm); color: var(--sl-color-gray-1); overflow-wrap: anywhere; }
  .links { margin-top: 0.5rem; display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; font-size: var(--sl-text-xs); font-weight: 600; }
  .links a { color: var(--ai-coral-ink); text-decoration: none; }
  .links a:hover { text-decoration: underline; }
</style>
