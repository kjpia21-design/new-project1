---
import LevelBadge from './LevelBadge.astro';
import Illustration from './Illustration.astro';
import { getTutorials, entryUrl, tutorialSlug, getCategoryLabel, categoryOrder, getLevelLabel, type Level, type Category } from '../lib/tutorials';
import { getLang, t } from '../lib/i18n';
import { groupClaude } from '../data/topic-groups.mjs';

interface Props {
  level?: Level;
  category?: Category;
  /** true면 수준·분야 필터 버튼을 위에 보여준다 */
  filters?: boolean;
  emptyText?: string;
  /** true면 한 줄짜리 목록 행으로 보여 준다(섹션 허브). 번호, 제목, 수준, 시간, 완료 ✓ */
  compact?: boolean;
  /** 'subgroup'이면 Claude 하위 그룹별 소제목으로 나눈다(category="claude"일 때만) */
  groupBy?: 'subgroup';
  /** true면 휴대폰(≤ 800px)에서 compact 행 모양으로 바꾼다(/tutorials/ 전체 목록) */
  mobileCompact?: boolean;
}
const Heading = Astro.props.filters ? 'h2' : 'h3';
const lang = getLang(Astro);
const { level, category, filters = false, emptyText = t(lang, 'grid.empty'), compact = false, groupBy, mobileCompact = false } = Astro.props;
const items = await getTutorials({ level, category, lang });
const levels: Level[] = ['beginner', 'practical', 'advanced'];

// 섹션 나누기: 기본은 한 덩어리. groupBy="subgroup"이면 Claude 하위 그룹(목록에 없는 글은 "기타")으로 나눈다.
type Sec = { id?: string; label?: string; items: typeof items };
let sections: Sec[] = [{ items }];
if (groupBy === 'subgroup' && category === 'claude' && items.length) {
  const fileOf = (e: (typeof items)[number]) => tutorialSlug(e.id).replace(/^claude\//, '');
  const byName = new Map(items.map((e) => [fileOf(e), e]));
  sections = groupClaude([...byName.keys()]).map((g) => ({
    id: g.id,
    label: lang === 'ko' ? g.ko : g.en,
    items: g.slugs.map((n) => byName.get(n)!).filter(Boolean),
  }));
}
const numOf = (e: (typeof items)[number], i: number) => {
  const m = tutorialSlug(e.id).split('/').pop()!.match(/^[a-z]?(\d+)/i);
  return m ? String(Number(m[1])) : String(i + 1);
};
const doneLabel = lang === 'ko' ? '완료' : 'Done';
---
<div class="tutorial-grid not-content" data-filterable={filters ? '' : undefined} data-result={t(lang, 'grid.count')}>
  {filters && (
    <div class="filters">
      <div class="search">
        <label for="tg-q">{t(lang, 'grid.search')}</label>
        <input id="tg-q" type="search" placeholder={t(lang, 'grid.placeholder')} autocomplete="off" />
      </div>
      <div class="group" role="group" aria-label={t(lang, 'grid.levelFilter')} data-group="level">
        <span class="group-label">{t(lang, 'grid.level')}</span>
        <button type="button" data-value="" aria-pressed="true">{t(lang, 'grid.allBtn')}</button>
        {levels.map((l) => <button type="button" data-value={l} aria-pressed="false">{getLevelLabel(l, lang)}</button>)}
      </div>
      <div class="group" role="group" aria-label={t(lang, 'grid.catFilter')} data-group="category">
        <span class="group-label">{t(lang, 'grid.cat')}</span>
        <button type="button" data-value="" aria-pressed="true">{t(lang, 'grid.allBtn')}</button>
        {categoryOrder.map((c) => <button type="button" data-value={c} aria-pressed="false">{getCategoryLabel(c, lang)}</button>)}
      </div>
      <div class="result-row">
        <p class="result" aria-live="polite"></p>
        {/* 완료한 글이 하나라도 있을 때만 Footer.astro의 진행 스크립트가 보이게 한다. 상태는 URL에 넣지 않는다(이 브라우저 전용). */}
        <button type="button" class="hide-done" data-hide-done aria-pressed="false" hidden>
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
          {t(lang, 'grid.hideDone')}
        </button>
      </div>
    </div>
  )}
  {items.length === 0 ? (
    <p class="empty">{emptyText}</p>
  ) : (
    sections.map((sec) => (
      <section class="sec" data-group-id={sec.id}>
        {sec.label && <h3 class="sec-title">{sec.label} <span class="sec-n">{sec.items.length}</span></h3>}
        <ul class:list={['cards', { compact, 'm-compact': mobileCompact }]}>
          {sec.items.map((e, i) => (
            <li class:list={['card', { soon: e.data.status === 'draft' }]} data-slug={tutorialSlug(e.id)} data-level={e.data.level} data-category={e.data.category} data-search={[e.data.title, e.data.description, ...(e.data.tools ?? [])].filter(Boolean).join(' ').toLowerCase()}>
              <a href={entryUrl(e.id)}>
                <span class="num" aria-hidden="true">{numOf(e, i)}</span>
                <div class="top">
                  <span class="cat"><Illustration name={e.data.category!} size={26} tone="neutral" bare />{getCategoryLabel(e.data.category!, lang)}</span>
                  {e.data.status === 'draft' && <span class="soon-tag">{t(lang, 'meta.draft')}</span>}
                </div>
                {(compact || mobileCompact) ? <Heading data-done-target>{e.data.title}</Heading> : <Heading>{e.data.title}</Heading>}
                {e.data.description && <p class="desc">{e.data.description}</p>}
                <p class="foot">
                  {e.data.level && <LevelBadge level={e.data.level} />}
                  {e.data.duration && <span class="dur">{e.data.duration}</span>}
                </p>
                <span class="chk" aria-hidden="true" title={doneLabel}>✓</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  )}
  {filters && <p class="empty none" hidden>{t(lang, 'grid.none')}</p>}
</div>

<style>
  .filters { display: grid; gap: 0.75rem; margin-bottom: 1.5rem; padding: 1.1rem 1.2rem; border: 1px solid var(--ai-line); border-radius: var(--ai-radius-lg); background: var(--ai-surface); box-shadow: var(--ai-shadow); }
  .search { display: grid; gap: 0.35rem; }
  .search label { font-weight: 600; font-size: var(--sl-text-xs); color: var(--sl-color-gray-2); }
  .search input {
    width: 100%; max-width: 30rem; box-sizing: border-box; min-height: 2.75rem; padding: 0.5rem 0.9rem; font: inherit; font-size: var(--sl-text-base);
    border: 1px solid var(--ai-line-strong); border-radius: 10px; background: var(--sl-color-black); color: var(--sl-color-white);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .search input::placeholder { color: var(--sl-color-gray-3); }
  .search input:hover { border-color: var(--sl-color-gray-3); }
  .search input:focus-visible { outline: 2px solid var(--ai-focus); outline-offset: 1px; border-color: var(--sl-color-accent); }
  .group { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
  .group-label { flex-basis: 100%; font-weight: 600; font-size: var(--sl-text-xs); color: var(--sl-color-gray-2); }
  .group button {
    border: 1px solid var(--ai-line); background: var(--ai-surface-2); color: var(--sl-color-gray-1);
    border-radius: 999px; min-height: 2rem; padding: 0.25rem 0.85rem; font: inherit; font-size: var(--sl-text-xs); font-weight: 500; cursor: pointer; line-height: 1.5;
    transition: border-color 0.15s, color 0.15s, background-color 0.15s;
  }
  .group button:hover { border-color: var(--ai-line-strong); color: var(--sl-color-white); }
  .group button[aria-pressed='true'] {
    background: var(--sl-color-white); border-color: var(--sl-color-white); color: var(--sl-color-black); font-weight: 600;
  }
  .result-row { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; flex-wrap: wrap; padding-top: 0.7rem; border-top: 1px solid var(--ai-line); }
  .result-row:has(.result:empty):has(.hide-done[hidden]) { display: none; }
  .hide-done {
    display: inline-flex; align-items: center; gap: 0.35rem; min-height: 2rem; padding: 0.25rem 0.8rem; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--ai-line); background: var(--ai-surface-2); color: var(--sl-color-gray-1); font: inherit; font-size: var(--sl-text-xs); font-weight: 500; line-height: 1.5;
    transition: border-color 0.15s, color 0.15s, background-color 0.15s;
  }
  .hide-done[hidden] { display: none; }
  .hide-done svg { color: var(--ai-accent-ink); }
  .hide-done:hover { border-color: var(--ai-line-strong); color: var(--sl-color-white); }
  .hide-done[aria-pressed='true'] { background: var(--ai-accent-soft); border-color: var(--ai-accent-line); color: var(--ai-accent-ink); font-weight: 600; }
  .result { margin: 0; font-size: var(--sl-text-xs); font-weight: 600; color: var(--sl-color-gray-2); font-variant-numeric: tabular-nums; }
  .result:empty { display: none; }
  /* 완료한 글(Footer.astro 스크립트가 data-done을 붙임): 제목 앞에 강조색 체크, 제목은 한 톤 낮춘다. */
  .card[data-done] :is(h2, h3) { color: var(--sl-color-gray-2); }
  .card[data-done] :is(h2, h3)::before {
    content: '✓' / ''; margin-inline-end: 0.35rem; color: var(--ai-accent-ink); font-weight: 700;
  }
  .sec + .sec { margin-top: 1.6rem; }
  .sec-title { margin: 0 0 0.6rem; font-size: var(--sl-text-sm); font-weight: 700; color: var(--sl-color-white); letter-spacing: -0.01em; display: flex; align-items: center; gap: 0.5rem; }
  .sec-n { font-size: var(--sl-text-2xs); font-weight: 600; color: var(--sl-color-gray-3); border: 1px solid var(--ai-line); border-radius: 999px; padding: 0 0.5rem; line-height: 1.6; font-variant-numeric: tabular-nums; }
  .num, .chk { display: none; }
  /* 한 줄 목록 행(섹션 허브 compact, 휴대폰의 /tutorials/): 번호 · 제목 · 수준 · 시간 · 완료 ✓ */
  .cards.compact { display: block; border: 1px solid var(--ai-line); border-radius: var(--ai-radius); background: var(--ai-surface); overflow: hidden; }
  .cards.compact .card:not([hidden]) ~ .card:not([hidden]) { border-top: 1px solid var(--ai-line); }
  .cards.compact .card a { border: 0; border-radius: 0; background: transparent; box-shadow: none; transform: none;
    display: grid; grid-template-columns: 2.1rem minmax(0, 1fr) auto 1.1rem; align-items: center; gap: 0.5rem 0.6rem; height: auto; min-height: 2.75rem; padding: 0.5rem 0.9rem; }
  .cards.compact .card a:hover { background: var(--ai-surface-2); }
  .cards.compact .num { display: block; font-size: var(--sl-text-xs); font-weight: 600; color: var(--sl-color-gray-3); font-variant-numeric: tabular-nums; text-align: end; }
  .cards.compact .top, .cards.compact .desc { display: none; }
  .cards.compact :is(h2, h3, h4) { margin: 0; font-size: var(--sl-text-sm); font-weight: 600; line-height: 1.4; min-width: 0; }
  .cards.compact .foot { margin: 0; padding: 0; flex-wrap: nowrap; white-space: nowrap; gap: 0.6rem; }
  .cards.compact .chk { display: block; width: 1.1rem; text-align: center; font-weight: 700; color: var(--ai-accent-ink); visibility: hidden; }
  .cards.compact .card[data-done] .chk { visibility: visible; }
  .cards.compact .card[data-done] :is(h2, h3, h4)::before { content: none; }
  .cards.compact .card.soon a { opacity: 0.7; }
  @media (max-width: 39.99rem) {
    .cards.compact .card a { grid-template-columns: 1.7rem minmax(0, 1fr) 1.1rem; grid-template-areas: 'n t c' '. f c'; padding: 0.55rem 0.8rem; row-gap: 0.1rem; }
    .cards.compact .num { grid-area: n; }
    .cards.compact :is(h2, h3, h4) { grid-area: t; }
    .cards.compact .foot { grid-area: f; font-size: var(--sl-text-2xs); }
    .cards.compact .chk { grid-area: c; }
  }
  @media (max-width: 50rem) {
    .cards.m-compact { display: block; border: 1px solid var(--ai-line); border-radius: var(--ai-radius); background: var(--ai-surface); overflow: hidden; }
    .cards.m-compact .card:not([hidden]) ~ .card:not([hidden]) { border-top: 1px solid var(--ai-line); }
    .cards.m-compact .card a { border: 0; border-radius: 0; background: transparent; box-shadow: none; transform: none;
      display: grid; grid-template-columns: minmax(0, 1fr) auto 1.1rem; align-items: center; gap: 0.5rem 0.6rem; height: auto; min-height: 2.75rem; padding: 0.5rem 0.9rem; }
    .cards.m-compact .card a:hover { background: var(--ai-surface-2); }
    .cards.m-compact .top, .cards.m-compact .desc { display: none; }
    .cards.m-compact :is(h2, h3, h4) { margin: 0; font-size: var(--sl-text-sm); font-weight: 600; line-height: 1.4; min-width: 0; }
    .cards.m-compact .foot { margin: 0; padding: 0; flex-wrap: nowrap; white-space: nowrap; gap: 0.6rem; }
    .cards.m-compact .chk { display: block; width: 1.1rem; text-align: center; font-weight: 700; color: var(--ai-accent-ink); visibility: hidden; }
    .cards.m-compact .card[data-done] .chk { visibility: visible; }
    .cards.m-compact .card[data-done] :is(h2, h3, h4)::before { content: none; }
    .cards.m-compact .card.soon a { opacity: 0.7; }
  }
  @media (max-width: 39.99rem) {
    .cards.m-compact .card a { grid-template-columns: minmax(0, 1fr) 1.1rem; grid-template-areas: 't c' 'f c'; padding: 0.55rem 0.8rem; row-gap: 0.1rem; }
    .cards.m-compact :is(h2, h3, h4) { grid-area: t; }
    .cards.m-compact .foot { grid-area: f; font-size: var(--sl-text-2xs); }
    .cards.m-compact .chk { grid-area: c; }
  }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); }
  .card { margin: 0; padding: 0; min-width: 0; }
  .card[hidden] { display: none; }
  .card a {
    display: flex; flex-direction: column; gap: 0.3rem; height: 100%;
    padding: 0.95rem 1.05rem 0.9rem; border-radius: var(--ai-radius); text-decoration: none;
    border: 1px solid var(--ai-line); background: var(--ai-surface);
    transition: border-color 0.15s, box-shadow 0.2s var(--ai-ease), transform 0.2s var(--ai-ease);
  }
  .card a:hover { border-color: var(--ai-line-strong); box-shadow: var(--ai-shadow-md); transform: translateY(-1px); }
  .card a:hover :is(h2, h3) { color: var(--ai-accent-ink); }
  .card.soon a { opacity: 0.75; }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .cat { display: inline-flex; align-items: center; gap: 0.4rem; min-width: 0; font-size: var(--sl-text-2xs); font-weight: 600; letter-spacing: 0.01em; color: var(--sl-color-gray-3); }
  .cat :global(.illu) { color: var(--sl-color-gray-3); }
  .soon-tag {
    flex: none; padding: 0.1rem 0.5rem; border-radius: 999px; font-size: var(--sl-text-2xs); font-weight: 600; line-height: 1.6;
    background: var(--ai-yellow-bg); color: var(--ai-yellow-fg);
  }
  h2, h3 { margin: 0.1rem 0 0; font-size: var(--sl-text-base); line-height: 1.4; color: var(--sl-color-white); font-weight: 650; letter-spacing: -0.01em; overflow-wrap: anywhere; transition: color 0.15s; }
  /* 설명은 3줄까지만 보여 카드 높이를 고르게 한다(전체 문장은 글에서 볼 수 있다). */
  .desc { margin: 0; font-size: var(--sl-text-xs); color: var(--sl-color-gray-2); line-height: 1.6; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden; }
  .foot { margin: auto 0 0; padding-top: 0.65rem; font-size: var(--sl-text-2xs); color: var(--sl-color-gray-3); display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .dur { font-variant-numeric: tabular-nums; }
  .empty { padding: 1rem 1.25rem; border: 1px dashed var(--ai-line-strong); border-radius: var(--ai-radius); color: var(--sl-color-gray-2); font-size: var(--sl-text-sm); margin: 0; }
  .empty[hidden] { display: none; }
  @media (min-width: 40rem) {
    .group-label { flex-basis: auto; min-width: 3rem; }
  }
  @media (max-width: 39.99rem) {
    /* 휴대폰: 필터 버튼을 한 줄로 두고 옆으로 밀어 보게 해서 목록이 바로 보이게 한다. */
    .filters { padding: 1rem; }
    .group button { flex: none; }
    /* 수준(4개)은 두 줄 안에 들어가므로 줄바꿈한다. */
    .group-label { flex: none; flex-basis: auto; min-width: 0; margin-inline-end: 0.2rem; }
    /* 분야(9개)는 한 줄로 두고 옆으로 밀어 본다. 오른쪽 끝을 흐리게 해서 더 있다는 걸 보여 주고, 끝까지 밀면 흐림을 없앤다. */
    .group[data-group='category'] {
      min-width: 0; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: -1rem; padding-inline: 1rem; scroll-padding-inline: 1rem; padding-block: 2px;
      scroll-snap-type: x proximity; overscroll-behavior-x: contain;
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 3rem), transparent);
      mask-image: linear-gradient(to right, #000 calc(100% - 3rem), transparent);
    }
    .group[data-group='category'][data-end] { -webkit-mask-image: none; mask-image: none; }
    .group[data-group='category']::-webkit-scrollbar { display: none; }
    .group[data-group='category'] > * { scroll-snap-align: start; }
  }
</style>

<script>
  class Filterable {
    constructor(root: HTMLElement) {
      const cards = Array.from(root.querySelectorAll<HTMLElement>('.card'));
      const input = root.querySelector<HTMLInputElement>('.search input');
      const state: Record<string, string> = { level: '', category: '' };
      const hideDone = root.querySelector<HTMLButtonElement>('[data-hide-done]');
      const params = new URLSearchParams(location.search);
      const allowed: Record<string, string[]> = {
        level: ['beginner', 'practical', 'advanced'],
        category: ['basics', 'claude', 'agents', 'dev', 'chat', 'coding', 'media', 'automation'],
      };
      for (const k of Object.keys(state)) {
        const v = params.get(k) ?? '';
        state[k] = allowed[k].includes(v) ? v : '';
      }

      const apply = () => {
        const q = (input?.value ?? '').trim().toLowerCase();
        let shown = 0;
        for (const c of cards) {
          const ok = (!state.level || c.dataset.level === state.level) && (!state.category || c.dataset.category === state.category) && (!q || (c.dataset.search ?? '').includes(q))
            && !(hideDone?.getAttribute('aria-pressed') === 'true' && c.hasAttribute('data-done'));
          c.hidden = !ok;
          if (ok) shown++;
        }
        root.querySelectorAll<HTMLButtonElement>('.group button').forEach((b) => {
          const g = (b.closest('.group') as HTMLElement).dataset.group!;
          b.setAttribute('aria-pressed', String(b.dataset.value === state[g]));
        });
        root.querySelector('.none')?.toggleAttribute('hidden', shown !== 0);
        const r = root.querySelector('.result');
        if (r) r.textContent = (root.dataset.result ?? '').replace('{n}', String(shown));
      };
      root.querySelectorAll<HTMLButtonElement>('.group button').forEach((b) =>
        b.addEventListener('click', () => {
          const g = (b.closest('.group') as HTMLElement).dataset.group!;
          state[g] = b.dataset.value ?? '';
          const p = new URLSearchParams();
          for (const [k, v] of Object.entries(state)) if (v) p.set(k, v);
          const qs = p.toString();
          history.replaceState(null, '', location.pathname + (qs ? `?${qs}` : ''));
          apply();
        }),
      );
      hideDone?.addEventListener('click', () => {
        hideDone.setAttribute('aria-pressed', String(hideDone.getAttribute('aria-pressed') !== 'true'));
        apply();
      });
      // 분야 줄: 끝까지 밀었으면 오른쪽 흐림을 없앤다.
      root.querySelectorAll<HTMLElement>('.group[data-group="category"]').forEach((g) => {
        const edge = () => g.toggleAttribute('data-end', g.scrollLeft + g.clientWidth >= g.scrollWidth - 2);
        g.addEventListener('scroll', edge, { passive: true });
        window.addEventListener('resize', edge);
        edge();
      });
      input?.addEventListener('input', apply);
      input?.addEventListener('keydown', (ev) => {
        if (ev.key === 'Escape' && input.value) { input.value = ''; apply(); }
      });
      apply();
    }
  }
  document.querySelectorAll<HTMLElement>('.tutorial-grid[data-filterable]').forEach((el) => new Filterable(el));
</script>
