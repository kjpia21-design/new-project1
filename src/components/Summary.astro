---
// 한눈에 요약 카드: 튜토리얼 맨 위에서 3~5줄 핵심만 보여준다. 본문은 slot(목록 또는 문단).
import { getLang, t } from '../lib/i18n';
interface Props { title?: string }
const lang = getLang(Astro);
const { title = t(lang, 'summary.title') } = Astro.props;
---
<section class="summary not-content" aria-label={title}>
  <div class="head">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3.5l2.2 6.3L20.5 12l-6.3 2.2L12 20.5l-2.2-6.3L3.5 12l6.3-2.2z" /></svg>
    <strong>{title}</strong>
  </div>
  <div class="body"><slot /></div>
</section>

<style>
  .summary {
    margin: 1.25rem 0 2rem; padding: 1.1rem 1.3rem 1.2rem;
    border: 1px solid var(--ai-coral-line); border-radius: var(--ai-radius-lg);
    background: var(--ai-coral-soft);
  }
  .head { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.6rem; font-size: var(--sl-text-sm); color: var(--ai-coral-ink); letter-spacing: 0.01em; }
  .head svg { width: 18px; height: 18px; flex: none; }
  .head strong { font-weight: 700; }
  .body { color: var(--sl-color-gray-1); line-height: 1.7; overflow-wrap: anywhere; font-size: var(--sl-text-base); }
  .body :global(ul), .body :global(ol) { margin: 0; padding-left: 1.2rem; }
  .body :global(li) { margin: 0.3rem 0; }
  .body :global(li::marker) { color: var(--ai-coral-ink); }
  .body :global(p) { margin: 0.3rem 0; }
  .body :global(strong) { color: var(--sl-color-white); font-weight: 650; }
  .body :global(a) { color: var(--ai-coral-ink); text-underline-offset: 0.2em; }
  @media (max-width: 40rem) { .summary { padding: 1rem 1.05rem 1.05rem; } .body { font-size: 0.9375rem; } }
</style>
