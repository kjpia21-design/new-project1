---
// 단순화한 절차 흐름도. 실제 화면을 흉내 내지 않고 "어디서 → 무엇을 누르면 → 무엇이 나오는지"만 보여 준다.
// 사용 예:
// <FlowSteps title="GitHub 연결하기" steps={[
//   { where: 'claude.ai/code', action: 'GitHub 연결 누르기' },
//   { where: 'GitHub 권한 화면', action: '저장소 선택 후 승인' },
// ]} />
import { getLang, t } from '../lib/i18n';
interface Step { where: string; action: string; result?: string }
interface Props { title?: string; steps: Step[]; officialUrl?: string }
const { title, steps, officialUrl } = Astro.props;
const lang = getLang(Astro);
---
<figure class="flow not-content" aria-label={title ?? t(lang, 'flow.label')}>
  {title && <figcaption class="flow-title">{title}</figcaption>}
  <ol class="flow-list">
    {steps.map((s, i) => (
      <li class="flow-step">
        <span class="num" aria-hidden="true">{i + 1}</span>
        <div class="body">
          <span class="where">{s.where}</span>
          <span class="action">{s.action}</span>
          {s.result && <span class="result">→ {s.result}</span>}
        </div>
      </li>
    ))}
  </ol>
  <p class="flow-note">
    {t(lang, 'flow.noteA')}{' '}
    {officialUrl
      ? <a href={officialUrl} target="_blank" rel="noopener noreferrer">{t(lang, 'flow.help')}</a>
      : t(lang, 'flow.help')}{t(lang, 'flow.noteB')}
  </p>
</figure>

<style>
  .flow {
    margin: 1.5rem 0;
    padding: 1rem 1.1rem;
    border: 1px solid var(--ai-line);
    border-radius: var(--ai-radius);
    background: var(--ai-surface-2);
  }
  .flow-title { margin: 0 0 0.75rem; font-size: var(--sl-text-sm); font-weight: 600; color: var(--sl-color-white); }
  .flow-list {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; align-items: stretch; gap: 0.6rem;
  }
  .flow-step {
    flex: 1 1 10rem; min-width: 0;
    display: flex; gap: 0.6rem; align-items: flex-start;
    margin: 0; padding: 0.7rem 0.8rem;
    border: 1px solid var(--ai-line);
    border-radius: var(--ai-radius-sm);
    background: var(--ai-surface);
    position: relative;
  }
  .flow-step:not(:last-child)::after {
    content: ''; position: absolute; right: -0.6rem; top: 50%; width: 0.6rem; height: 1px; background: var(--ai-line-strong);
  }
  .num {
    flex: none; width: 1.35rem; height: 1.35rem; border-radius: 999px; margin-top: 0.05rem;
    display: inline-flex; align-items: center; justify-content: center;
    border: 1.5px solid var(--ai-coral); color: var(--ai-coral-ink); font-size: var(--sl-text-2xs); font-weight: 700; font-variant-numeric: tabular-nums;
  }
  .body { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .where { font-size: var(--sl-text-2xs); color: var(--sl-color-gray-3); overflow-wrap: anywhere; }
  .action { font-size: var(--sl-text-sm); font-weight: 600; color: var(--sl-color-white); overflow-wrap: anywhere; }
  .result { font-size: var(--sl-text-xs); color: var(--sl-color-gray-2); overflow-wrap: anywhere; }
  .flow-note { margin: 0.75rem 0 0; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
  .flow-note a { color: var(--sl-color-gray-2); }
  @media (max-width: 40rem) {
    .flow-list { flex-direction: column; gap: 0.6rem; }
    .flow-step { flex: none; }
    .flow-step:not(:last-child)::after { right: auto; left: 1.45rem; top: auto; bottom: -0.6rem; width: 1px; height: 0.6rem; }
  }
</style>
