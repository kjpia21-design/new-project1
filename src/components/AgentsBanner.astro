---
import Illustration from './Illustration.astro';
import { url } from '../lib/tutorials';
import { getLang, t } from '../lib/i18n';
const lang = getLang(Astro);
---
<a class="banner not-content" href={url('/agents/', lang)}>
  <Illustration name="agents" size={44} tone="neutral" />
  <div class="text">
    <p class="eyebrow">{t(lang, 'agents.eyebrow')}</p>
    <p class="title">Meta Muse · Grok Bot · ChatGPT Dots</p>
    <p class="desc">{t(lang, 'agents.desc')}</p>
  </div>
  <span class="go">{t(lang, 'banner.go')}</span>
</a>

<style>
  .banner {
    display: flex; align-items: center; gap: 1.1rem; padding: 1.1rem 1.4rem; margin-top: 0.875rem;
    border-radius: var(--ai-radius-lg); text-decoration: none;
    background: var(--ai-surface-2); border: 1px solid var(--ai-line);
    transition: border-color 0.15s, background-color 0.15s;
  }
  .banner:hover { border-color: var(--ai-line-strong); background: var(--ai-surface); }
  .text { flex: 1; min-width: 0; }
  p { margin: 0; }
  .eyebrow { font-size: var(--sl-text-xs); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--sl-color-gray-3); }
  .title { margin-top: 0.15rem; font-size: 1.05rem; font-weight: 650; color: var(--sl-color-white); letter-spacing: -0.01em; }
  .desc { margin-top: 0.25rem; font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); line-height: 1.55; }
  .go { flex: none; display: inline-flex; align-items: center; gap: 0.3rem; font-size: var(--sl-text-sm); font-weight: 600; color: var(--sl-color-gray-1); }
  @media (max-width: 600px) {
    .banner { flex-wrap: wrap; }
    .go { width: 100%; padding-left: calc(44px + 1.1rem); }
  }
</style>
