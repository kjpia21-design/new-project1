---
// Starlight 기본 Footer 오버라이드: 튜토리얼 페이지 하단(이전/다음 링크 위)에 출처 상자를 자동으로 붙인다.
import Default from '@astrojs/starlight/components/Footer.astro';
import Sources from './Sources.astro';
import { isTutorial } from '../lib/tutorials';
import { getLang, t } from '../lib/i18n';

const lang = getLang(Astro);

const entry = Astro.locals.starlightRoute.entry;
const showSources = isTutorial(entry.id) && entry.data.status === 'published';
---
{showSources && <Sources sources={entry.data.sources} lastVerified={entry.data.lastVerified} lang={lang} />}
<Default {...Astro.props}><slot /></Default>
<script is:inline define:vars={{ tableLabel: t(lang, 'table.label') }}>
  // 좁은 화면에서 가로 스크롤이 생기는 표를 키보드로도 스크롤할 수 있게 한다.
  (function () {
    function mark() {
      document.querySelectorAll('.sl-markdown-content table').forEach(function (t) {
        if (t.scrollWidth > t.clientWidth + 1 && !t.hasAttribute('tabindex')) {
          t.setAttribute('tabindex', '0');
          t.setAttribute('role', 'region');
          t.setAttribute('aria-label', tableLabel);
        }
      });
    }
    window.addEventListener('load', mark);
    window.addEventListener('resize', mark);
  })();
</script>
