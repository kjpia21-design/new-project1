---
// Starlight 기본 Footer 오버라이드: 튜토리얼 페이지 하단(이전/다음 링크 위)에 출처 상자와 "완료로 표시" 상자를 자동으로 붙인다.
import Default from '@astrojs/starlight/components/Footer.astro';
import Sources from './Sources.astro';
import TutorialProgress from './TutorialProgress.astro';
import { isTutorial } from '../lib/tutorials';
import { getLang, t } from '../lib/i18n';

const lang = getLang(Astro);

const entry = Astro.locals.starlightRoute.entry;
const tutorial = isTutorial(entry.id);
const showSources = tutorial && entry.data.status === 'published';
---
{showSources && <Sources sources={entry.data.sources} lastVerified={entry.data.lastVerified} lang={lang} />}
{tutorial && <TutorialProgress />}
<Default {...Astro.props}><slot /></Default>
<script is:inline define:vars={{ tableLabel: t(lang, 'table.label') }}>
  // 좁은 화면에서 가로 스크롤이 생기는 표를 키보드로도 스크롤할 수 있게 한다.
  (function () {
    function mark() {
      document.querySelectorAll('.sl-markdown-content table').forEach(function (t) {
        if (t.scrollWidth > t.clientWidth + 1 && !t.hasAttribute('tabindex')) {
          t.setAttribute('tabindex', '0');
          t.setAttribute('role', 'region');
          t.setAttribute('aria-label', tableLabel);
        }
      });
    }
    window.addEventListener('load', mark);
    window.addEventListener('resize', mark);

    // 사이드바에서 현재 글이 스크롤 영역 밖이면 가운데로 보이게 한다. 이미 보이면 아무것도 하지 않는다.
    function revealCurrent() {
      var a = document.querySelector('.sidebar-content a[aria-current="page"]');
      var box = document.querySelector('.sidebar-pane') || document.querySelector('.sidebar-content');
      if (!a || !box) return;
      var r = a.getBoundingClientRect(), b = box.getBoundingClientRect();
      if (!r.width || !b.height) return; // 숨겨진 상태(닫힌 모바일 메뉴)
      if (r.top >= b.top && r.bottom <= b.bottom) return;
      a.scrollIntoView({ block: 'center' });
    }
    window.addEventListener('load', revealCurrent);
    document.addEventListener('click', function (e) {
      if (e.target && e.target.closest && e.target.closest('starlight-menu-button, [aria-controls="starlight__sidebar"]')) setTimeout(revealCurrent, 60);
    });
  })();
</script>
{/*
  학습 진행 기록(로그인 없음, 이 브라우저에만 저장, 외부 전송 없음).
  - atc:progress:v1 = { "<ko/ 없는 slug>": { done: <epoch 초> } } → 영어·한국어가 같은 기록을 쓴다.
  - atc:last = { slug, title, lang, at } → 튜토리얼을 볼 때마다 갱신, 홈 "이어 보기" 카드에 쓴다.
  저장소를 못 쓰면(사생활 보호 모드 등) 기록 없이 그대로 동작한다.
*/}
<script is:inline define:vars={{ srDone: t(lang, 'done.sr'), lang }}>
  document.addEventListener('DOMContentLoaded', function () {
    var KEY = 'atc:progress:v1', LAST = 'atc:last', de = document.documentElement;
    function read(k) { try { var v = JSON.parse(localStorage.getItem(k) || 'null'); return v && typeof v === 'object' ? v : null; } catch (e) { return null; } }
    function write(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }
    var prog = read(KEY) || {};
    function slugOf(href) {
      var p; try { p = new URL(href, location.href).pathname; } catch (e) { return ''; }
      return p.replace(/^\/ko(?=\/|$)/, '').replace(/^\/+|\/+$/g, '');
    }
    function flag(el, target, done) {
      var sr = target.querySelector('.atc-sr');
      if (done) {
        el.setAttribute('data-done', '');
        if (!sr) { sr = document.createElement('span'); sr.className = 'atc-sr sr-only'; sr.textContent = ' (' + srDone + ')'; target.appendChild(sr); }
      } else { el.removeAttribute('data-done'); if (sr) sr.remove(); }
    }
    function markAll() {
      document.querySelectorAll('.sidebar-content a[href]').forEach(function (a) { flag(a, a, !!prog[slugOf(a.href)]); });
      var any = false;
      // 카드(TutorialGrid), 학습 경로 단계(LearningPath), 먼저 볼 글(TutorialMeta)
      document.querySelectorAll('[data-slug]').forEach(function (c) {
        var d = !!prog[c.getAttribute('data-slug')]; if (d && c.classList.contains('card')) any = true;
        flag(c, c.querySelector('[data-done-target], h2, h3') || c, d);
      });
      document.querySelectorAll('[data-hide-done]').forEach(function (b) { if (any) b.hidden = false; });
      // 진행 상태 공통 규약: data-atc-count="slug ..." → .atc-count-done 텍스트, --atc-pct, data-atc-started
      document.querySelectorAll('[data-atc-count]').forEach(function (el) {
        var list = (el.getAttribute('data-atc-count') || '').split(/\s+/).filter(Boolean), n = 0;
        list.forEach(function (sl) { if (prog[sl]) n++; });
        el.querySelectorAll('.atc-count-done').forEach(function (x) { x.textContent = n; });
        if (el.classList.contains('atc-count-done')) el.textContent = n;
        el.style.setProperty('--atc-pct', list.length ? Math.round(n / list.length * 100) : 0);
        if (n > 0) el.setAttribute('data-atc-started', ''); else el.removeAttribute('data-atc-started');
      });
      // data-atc-next: 목록(자기 자신, 안쪽, 가까운 바깥의 data-atc-count)에서 아직 안 본 첫 글로 a.atc-next를 바꾼다.
      document.querySelectorAll('[data-atc-next]').forEach(function (el) {
        var a = el.matches('a.atc-next') ? el : el.querySelector('a.atc-next');
        if (!a) return;
        var src = el.hasAttribute('data-atc-count') ? el : (el.closest('[data-atc-count]') || el.querySelector('[data-atc-count]'));
        var raw = el.getAttribute('data-atc-next') || (src && src.getAttribute('data-atc-count')) || '';
        var list = raw.split(/\s+/).filter(Boolean);
        var next = null;
        for (var i = 0; i < list.length; i++) if (!prog[list[i]]) { next = list[i]; break; }
        if (!next) { el.setAttribute('data-atc-alldone', ''); return; }
        el.removeAttribute('data-atc-alldone');
        var titles = {}, tEl = el.hasAttribute('data-atc-titles') ? el : (el.closest('[data-atc-titles]') || el.querySelector('[data-atc-titles]') || (src && src.hasAttribute('data-atc-titles') ? src : null));
        try { titles = JSON.parse((tEl && tEl.getAttribute('data-atc-titles')) || '{}') || {}; } catch (e) {}
        a.setAttribute('href', (lang === 'ko' ? '/ko' : '') + '/' + next + '/');
        var title = titles[next];
        if (title) { var tt = a.querySelector('.atc-next-title'); if (tt) tt.textContent = title; else a.textContent = title; }
      });
      // 학습 경로: "N/M 완료", 진행 막대, 첫 미완료 단계로 "이어 하기"
      document.querySelectorAll('[data-lp]').forEach(function (p) {
        var st = p.querySelectorAll('.lp-step'), n = 0, k = -1;
        st.forEach(function (s, i) { s.removeAttribute('data-next'); if (s.hasAttribute('data-done')) n++; else if (k < 0) k = i; });
        var go = p.querySelector('[data-lp-go]'), cnt = p.querySelector('[data-lp-count]'), tr = p.querySelector('[data-lp-track]');
        if (!st.length || !go) return;
        if (cnt) { cnt.textContent = p.getAttribute('data-t-done').replace('{n}', n).replace('{m}', st.length); cnt.hidden = false; }
        if (tr) { tr.hidden = false; tr.firstElementChild.style.width = (n / st.length * 100) + '%'; }
        if (n === 0) return;
        var to = st[k < 0 ? 0 : k];
        if (k >= 0) to.setAttribute('data-next', '');
        go.textContent = k < 0 ? p.getAttribute('data-t-complete') : p.getAttribute('data-t-continue').replace('{k}', k + 1);
        go.href = to.querySelector('a').href;
      });
    }

    // 튜토리얼 페이지: 마지막으로 본 글 기록 + 완료 버튼 + 휴대폰 하단 바
    var box = document.querySelector('[data-atc-slug]');
    if (box) {
      var slug = box.getAttribute('data-atc-slug');
      write(LAST, { slug: slug, title: box.getAttribute('data-atc-title'), lang: lang, at: Math.floor(Date.now() / 1000) });
      box.hidden = false;
      var btns = document.querySelectorAll('.atc-done-btn');
      var sync = function () { btns.forEach(function (b) { b.setAttribute('aria-pressed', String(!!prog[slug])); }); markAll(); };
      btns.forEach(function (b) {
        b.addEventListener('click', function () {
          prog = read(KEY) || prog;
          if (prog[slug]) delete prog[slug]; else prog[slug] = { done: Math.floor(Date.now() / 1000) };
          write(KEY, prog); sync();
        });
      });
      sync();

      var dock = document.querySelector('[data-atc-dock]'), content = document.querySelector('.sl-markdown-content');
      if (dock && content && 'IntersectionObserver' in window) {
        var mq = matchMedia('(max-width: 49.99rem)'), passed = false, seen = new Set();
        var m = document.createElement('div');
        m.setAttribute('aria-hidden', 'true');
        m.style.cssText = 'position:absolute;top:60%;left:0;width:1px;height:1px;pointer-events:none';
        if (getComputedStyle(content).position === 'static') content.style.position = 'relative';
        content.appendChild(m);
        var upd = function () {
          var show = mq.matches && passed && seen.size === 0;
          dock.toggleAttribute('data-show', show);
          if (show) de.style.setProperty('--atc-dock-h', dock.offsetHeight + 'px');
          de.classList.toggle('atc-dock-on', show);
        };
        new IntersectionObserver(function (es) {
          es.forEach(function (e) { passed = e.isIntersecting || e.boundingClientRect.top < 0; }); upd();
        }).observe(m);
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) seen.add(e.target); else seen.delete(e.target); }); upd();
        });
        [box, document.querySelector('.pagination-links')].forEach(function (el) { if (el) io.observe(el); });
        if (mq.addEventListener) mq.addEventListener('change', upd);
      }
    } else {
      markAll();
      // 튜토리얼에서 완료 표시 후 "뒤로"로 돌아오면(bfcache) 기록을 다시 읽는다.
      window.addEventListener('pageshow', function (e) { if (e.persisted) { prog = read(KEY) || {}; markAll(); } });
    }

    // 홈 대시보드: 이어 보기 카드, 학습 현황, 시리즈 진행, 학습 경로 카드
    function jsonOf(id) { try { return JSON.parse(document.getElementById(id).textContent); } catch (e) { return null; } }
    function fill(tpl, o) { return tpl.replace(/\{(\w+)\}/g, function (m, k) { return k in o ? o[k] : m; }); }
    function home() {
      var map = jsonOf('atc-tutorials');
      if (!map) return;
      var valid = Object.keys(map), doneN = valid.filter(function (k) { return prog[k]; }).length;
      var st = document.querySelector('[data-hd-status]');
      if (st) st.textContent = fill(st.getAttribute('data-t'), { n: valid.length, m: doneN });
      var cont = document.querySelector('[data-atc-continue]');
      if (cont) {
        var last = read(LAST), series = jsonOf('atc-series') || {};
        if (last && typeof last.slug === 'string' && Object.prototype.hasOwnProperty.call(map, last.slug)) {
          var href = cont.getAttribute('data-prefix') + '/' + last.slug + '/';
          if (cont.tagName === 'A') cont.href = href;
          var go = cont.querySelector('[data-atc-continue-go]'); if (go) go.href = href;
          cont.querySelector('.ct').textContent = map[last.slug];
          var cat = last.slug.split('/')[0], sr = series[cat];
          if (sr) {
            var d = sr.slugs.filter(function (k) { return prog[k]; }).length, i = sr.slugs.indexOf(last.slug) + 1;
            var meta = cont.querySelector('.cmeta'); if (meta) meta.textContent = sr.label + ' · ' + i + '/' + sr.slugs.length;
            var rt = cont.querySelector('.rt'); if (rt) rt.textContent = fill(cont.getAttribute('data-t-series'), { d: d, n: sr.slugs.length });
            var bar = cont.querySelector('.bar i'); if (bar) bar.style.width = (d / sr.slugs.length * 100) + '%';
          }
          cont.hidden = false;
        } else cont.hidden = true;
      }
      // 내 학습 경로: 진행 중(1단계 이상 완료, 전부는 아님)인 경로 중 비율이 가장 높은 것
      var pc = document.querySelector('[data-hd-path]'), ps = jsonOf('atc-paths');
      if (pc && ps) {
        var best = null;
        ps.forEach(function (p) {
          var d = p.steps.filter(function (x) { return prog[x.s]; }).length;
          if (d > 0 && d < p.steps.length && (!best || d / p.steps.length > best.d / best.p.steps.length)) best = { p: p, d: d };
        });
        var act = pc.querySelector('.hp-active'), none = pc.querySelector('.hp-none');
        if (best) {
          var nx = best.p.steps.filter(function (x) { return !prog[x.s]; })[0], k = best.p.steps.indexOf(nx) + 1, tot = best.p.steps.length;
          pc.querySelector('.hp-title').textContent = best.p.title;
          pc.querySelector('.hp-sub').textContent = fill(pc.getAttribute('data-t-sub'), { d: best.d, n: tot });
          pc.querySelector('.bar i').style.width = (best.d / tot * 100) + '%';
          pc.querySelector('.hp-pct').textContent = Math.round(best.d / tot * 100) + '%';
          var a = pc.querySelector('.nextstep'); a.href = (lang === 'ko' ? '/ko' : '') + '/' + nx.s + '/';
          a.querySelector('em').textContent = k;
          pc.querySelector('.hp-next').textContent = nx.t + (nx.m ? ' · ' + nx.m + (lang === 'ko' ? '분' : ' min') : '');
          act.hidden = false; none.hidden = true;
        } else { act.hidden = true; none.hidden = false; }
      }
    }
    home();
    window.addEventListener('pageshow', function (e) { if (e.persisted) { prog = read(KEY) || {}; home(); } });
    // 홈 큰 검색 상자: Starlight(Pagefind) 검색 창을 연다.
    document.querySelectorAll('[data-hd-search]').forEach(function (b) {
      b.addEventListener('click', function () {
        var o = document.querySelector('site-search button[data-open-modal]') || document.querySelector('button[data-open-modal]');
        if (o) o.click(); else document.dispatchEvent(new KeyboardEvent('keydown', { key: 'k', ctrlKey: true, bubbles: true }));
      });
    });
  });
</script>
