---
import { getLang, t } from '../lib/i18n';
interface Props { label?: string }
const lang = getLang(Astro);
const { label = t(lang, 'prompt.label') } = Astro.props;
---
<prompt-box class="not-content" data-copy={t(lang, 'prompt.copy')} data-copied={t(lang, 'prompt.copied')} data-manual={t(lang, 'prompt.manual')}>
  <div class="head">
    <span class="label">{label}</span>
    <button type="button" class="copy" aria-live="polite">{t(lang, 'prompt.copy')}</button>
  </div>
  <div class="body"><slot /></div>
</prompt-box>

<style>
  prompt-box {
    display: block;
    margin: 1.25rem 0;
    border: 1px solid var(--ai-line);
    border-radius: var(--ai-radius);
    background: var(--ai-surface);
    overflow: hidden;
  }
  .head {
    display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
    padding: 0.45rem 0.6rem 0.45rem 1rem;
    background: var(--ai-surface-2); border-bottom: 1px solid var(--ai-line);
  }
  .label { display: inline-flex; align-items: center; gap: 0.45rem; font-size: var(--sl-text-xs); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--sl-color-gray-3); }
  .label::before { content: ''; width: 6px; height: 6px; border-radius: 999px; background: var(--ai-coral); }
  .copy {
    flex: none; display: inline-flex; align-items: center; gap: 0.35rem;
    border: 1px solid var(--ai-line); border-radius: var(--ai-radius-sm); cursor: pointer;
    padding: 0.25rem 0.65rem;
    background: var(--ai-surface); color: var(--sl-color-gray-1);
    font: inherit; font-size: var(--sl-text-xs); font-weight: 600; line-height: 1.5;
    transition: border-color 0.15s, color 0.15s, background-color 0.15s;
  }
  .copy:hover { border-color: var(--ai-line-strong); color: var(--sl-color-white); }
  .copy:active { background: var(--ai-surface-2); }
  .body { padding: 0.9rem 1rem; white-space: pre-wrap; overflow-wrap: anywhere; color: var(--sl-color-white); font-size: var(--sl-text-sm); line-height: 1.7; }
  .body :global(p) { margin: 0; }
</style>

<script>
  class PromptBox extends HTMLElement {
    connectedCallback() {
      const btn = this.querySelector<HTMLButtonElement>('.copy');
      const body = this.querySelector<HTMLElement>('.body');
      btn?.addEventListener('click', async () => {
        const text = body?.innerText.trim() ?? '';
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = this.dataset.copied ?? '';
        } catch {
          btn.textContent = this.dataset.manual ?? '';
          if (body) {
            const range = document.createRange();
            range.selectNodeContents(body);
            const sel = window.getSelection();
            sel?.removeAllRanges();
            sel?.addRange(range);
          }
        }
        setTimeout(() => (btn.textContent = this.dataset.copy ?? ''), 1800);
      });
    }
  }
  if (!customElements.get('prompt-box')) customElements.define('prompt-box', PromptBox);
</script>
