---
// Starlight 기본 PageTitle 오버라이드: 제목 아래에 튜토리얼 정보 상자를 자동으로 붙인다.
import TutorialMeta from './TutorialMeta.astro';
import { isTutorial } from '../lib/tutorials';

const PAGE_TITLE_ID = '_top'; // Starlight 목차가 가리키는 제목 id
const entry = Astro.locals.starlightRoute.entry;
const { title, level, category, duration, prerequisites, tools, lastVerified, status } = entry.data;
const isHome = entry.id === 'index' || entry.id === '';
const showMeta = isTutorial(entry.id);
---
{isHome ? (
  <Fragment />
) : (
  <h1 id={PAGE_TITLE_ID}>{title}</h1>
)}
{showMeta && (
  <TutorialMeta {level} {category} {duration} {prerequisites} {tools} {lastVerified} {status} />
)}

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 800;
      color: var(--sl-color-white);
    }
  }
</style>
