---
// frontmatter의 sources와 마지막 확인일을 페이지 하단에 렌더링한다. Footer 오버라이드에서 자동으로 붙는다.
import { formatDate } from '../lib/tutorials';
import { getLang, t, type Lang } from '../lib/i18n';
interface Props { sources?: { title: string; url: string }[]; lastVerified?: Date; lang?: Lang }
const { sources = [], lastVerified } = Astro.props;
const lang = Astro.props.lang ?? getLang(Astro);
---
<section class="sources not-content" aria-labelledby="sources-title">
  <h2 id="sources-title">{t(lang, 'sources.title')}</h2>
  <p class="verified">{t(lang, 'sources.verified')}: <strong>{lastVerified ? formatDate(lastVerified, lang) : t(lang, 'sources.notYet')}</strong></p>
  {sources.length > 0 ? (
    <ul>
      {sources.map((s) => (
        <li><a href={s.url} rel="noopener noreferrer" target="_blank">{s.title}</a> <span class="host">{new URL(s.url).host}</span></li>
      ))}
    </ul>
  ) : (
    <p class="none">{t(lang, 'sources.none')}</p>
  )}
  <p class="note">{t(lang, 'sources.note')}</p>
</section>

<style>
  .sources {
    margin: 3rem 0 1rem; padding: 1.25rem 0 0;
    border-top: 1px solid var(--ai-line);
  }
  h2 { margin: 0 0 0.4rem; font-size: var(--sl-text-xs); font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--sl-color-gray-3); border: 0; }
  .verified, .note, .none { margin: 0.25rem 0; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
  .verified strong { color: var(--sl-color-gray-1); font-weight: 600; }
  ul { margin: 0.5rem 0; padding-left: 1.1rem; font-size: var(--sl-text-sm); }
  li { margin: 0.2rem 0; overflow-wrap: anywhere; }
  a { color: var(--sl-color-gray-1); text-decoration: underline; text-decoration-color: var(--ai-line-strong); text-underline-offset: 0.18em; }
  a:hover { color: var(--ai-coral-ink); text-decoration-color: currentColor; }
  .host { margin-left: 0.4rem; font-size: var(--sl-text-2xs); color: var(--sl-color-gray-3); }
</style>
