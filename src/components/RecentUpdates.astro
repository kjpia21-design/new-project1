---
import LevelBadge from './LevelBadge.astro';
import { getRecentlyVerified, entryUrl, formatDate } from '../lib/tutorials';
import { getLang, t } from '../lib/i18n';
interface Props { limit?: number }
const { limit = 5 } = Astro.props;
const lang = getLang(Astro);
const items = await getRecentlyVerified(limit, lang);
---
{items.length === 0 ? (
  <p class="empty not-content">{t(lang, 'recent.empty')}</p>
) : (
  <ul class="updates not-content">
    {items.map((e) => (
      <li>
        <time datetime={e.data.lastVerified!.toISOString().slice(0, 10)}>{lang === 'en' ? `${t(lang, 'recent.verified')} ${formatDate(e.data.lastVerified, lang)}` : `확인 ${formatDate(e.data.lastVerified, lang)}`}</time>
        {e.data.level && <LevelBadge level={e.data.level} />}
        <a href={entryUrl(e.id)}>{e.data.title}</a>
      </li>
    ))}
  </ul>
)}

<style>
  .updates { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  li { margin: 0; padding: 0.7rem 1rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.8rem; border-radius: 12px; background: var(--ai-card); border: 1px solid var(--sl-color-gray-5); }
  time { font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
  a { font-weight: 700; color: var(--sl-color-white); text-decoration: none; }
  a:hover { color: var(--sl-color-accent-high); }
  .empty { margin: 0; padding: 1rem 1.25rem; border: 2px dashed var(--sl-color-gray-4); border-radius: 14px; color: var(--sl-color-gray-2); }
</style>
