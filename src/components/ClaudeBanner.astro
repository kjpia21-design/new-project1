---
import Illustration from './Illustration.astro';
import { url, getTutorials } from '../lib/tutorials';
import { getLang, t } from '../lib/i18n';
const lang = getLang(Astro);
const claudeCount = (await getTutorials({ category: 'claude', lang })).length;
---
<div class="banner not-content">
  <a class="cover" href={url('/claude/', lang)} aria-label={t(lang, 'claude.cover')}></a>
  <Illustration name="claude" size={44} />
  <div class="text">
    <p class="eyebrow">{t(lang, 'claude.eyebrow')}</p>
    <p class="title">{t(lang, 'cat.claude')}</p>
    <p class="desc">{t(lang, 'claude.desc', { n: claudeCount })}</p>
  </div>
  <div class="links">
    <span class="go">{t(lang, 'banner.go')}</span>
    <a class="news" href={url('/claude-news/', lang)}>{t(lang, 'claude.news')}</a>
  </div>
</div>

<style>
  .banner {
    position: relative; display: flex; align-items: center; gap: 1.1rem; padding: 1.25rem 1.4rem;
    border-radius: var(--ai-radius-lg); background: var(--ai-surface); border: 1px solid var(--ai-line); box-shadow: var(--ai-shadow);
    background-image: linear-gradient(100deg, color-mix(in srgb, var(--ai-coral) 7%, transparent), transparent 55%);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .banner:hover { border-color: var(--ai-line-strong); box-shadow: var(--ai-shadow-md); }
  .cover { position: absolute; inset: 0; border-radius: var(--ai-radius-lg); }
  .text { flex: 1; min-width: 0; }
  p { margin: 0; }
  .eyebrow { font-size: var(--sl-text-xs); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ai-coral-ink); }
  .title { margin-top: 0.15rem; font-size: 1.15rem; font-weight: 650; color: var(--sl-color-white); letter-spacing: -0.01em; }
  .desc { margin-top: 0.25rem; font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); line-height: 1.55; }
  .links { position: relative; z-index: 1; flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 0.4rem; pointer-events: none; }
  .go { display: inline-flex; align-items: center; gap: 0.3rem; font-size: var(--sl-text-sm); font-weight: 600; color: var(--ai-coral-ink); }
  .news { pointer-events: auto; text-decoration: none; font-size: var(--sl-text-xs); font-weight: 500; color: var(--sl-color-gray-3); border-bottom: 1px solid var(--ai-line-strong); }
  .news:hover { color: var(--sl-color-white); border-color: var(--sl-color-gray-3); }
  @media (max-width: 600px) {
    .banner { flex-wrap: wrap; }
    .links { flex-direction: row; align-items: center; gap: 1rem; width: 100%; padding-left: calc(44px + 1.1rem); }
  }
</style>
