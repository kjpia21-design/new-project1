---
import Illustration from './Illustration.astro';
import { getLang, t } from '../lib/i18n';
interface Props {
  caption: string;
  src?: string;
  alt?: string;
  /** 실제 화면이 나오는 공식 도움말·문서 주소 */
  officialUrl?: string;
  /** 링크 문구 (기본: 공식 도움말에서 이 화면 보기) */
  officialLabel?: string;
}
const { caption, src, alt, officialUrl } = Astro.props;
const lang = getLang(Astro);
const officialLabel = Astro.props.officialLabel ?? t(lang, 'shot.official');
---
<figure class:list={["shot", "not-content", { compact: !src }]}>
  {!src && (
    <p class="line">
      <span><svg class="cam" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 8.5A2.5 2.5 0 0 1 6.5 6h1.8l1.2-2h5l1.2 2h1.8A2.5 2.5 0 0 1 20 8.5v8A2.5 2.5 0 0 1 17.5 19h-11A2.5 2.5 0 0 1 4 16.5z"/><circle cx="12" cy="12.5" r="3.2"/></svg>{t(lang, 'shot.guide')}: {caption}</span>
      {officialUrl && (
        <a class="official" href={officialUrl} target="_blank" rel="noopener noreferrer">{officialLabel} ↗</a>
      )}
    </p>
  )}
  {src && <div class="head">
    <Illustration name="media" size={24} tone="neutral" />
    <p class="title">{t(lang, 'shot.title')}</p>
  </div>}
  {src && <img class="img" src={src} alt={alt ?? caption} loading="lazy" />}
  {src && <figcaption class="cap">{caption}</figcaption>}
  {src && officialUrl && (
    <a class="official" href={officialUrl} target="_blank" rel="noopener noreferrer">
      {officialLabel} ↗
    </a>
  )}
  {src && <p class="note">{t(lang, 'shot.note')}</p>}
</figure>

<style>
  .shot {
    margin: 1.5rem 0;
    padding: 0.85rem 1rem 0.9rem;
    display: flex; flex-direction: column; align-items: flex-start; gap: 0.35rem;
    border: 1px solid var(--ai-line);
    border-radius: var(--ai-radius);
    background: var(--ai-surface);
    text-align: left;
  }
  .shot.compact { margin: 1rem 0; padding: 0.5rem 0.85rem; gap: 0; border-style: dashed; background: transparent; }
  .line { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.1rem 0.75rem; font-size: var(--sl-text-xs); line-height: 1.55; color: var(--sl-color-gray-2); }
  .line span { overflow-wrap: anywhere; }
  .line .cam { display: inline-block; width: 14px; height: 14px; vertical-align: -2px; margin-right: 0.35rem; color: var(--sl-color-gray-3); }
  .head { display: flex; align-items: center; gap: 0.5rem; }
  .head :global(svg) { flex: none; }
  .title { margin: 0; font-size: var(--sl-text-2xs); font-weight: 600; color: var(--sl-color-gray-3); letter-spacing: 0.05em; text-transform: uppercase; }
  .img { display: block; max-width: 100%; height: auto; margin: 0.25rem 0; border-radius: var(--ai-radius-sm); border: 1px solid var(--ai-line); }
  .cap { margin: 0; color: var(--sl-color-gray-1); font-size: var(--sl-text-sm); line-height: 1.6; overflow-wrap: anywhere; }
  .official { font-size: var(--sl-text-xs); font-weight: 600; color: var(--ai-coral-ink); text-decoration: none; overflow-wrap: anywhere; }
  .official:hover { text-decoration: underline; }
  .note { margin: 0; color: var(--sl-color-gray-3); font-size: var(--sl-text-2xs); }
</style>
