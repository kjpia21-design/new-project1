---
import Illustration from './Illustration.astro';
interface Props {
  caption: string;
  src?: string;
  alt?: string;
  /** 실제 화면이 나오는 공식 도움말·문서 주소 */
  officialUrl?: string;
  /** 링크 문구 (기본: 공식 도움말에서 이 화면 보기) */
  officialLabel?: string;
}
const { caption, src, alt, officialUrl, officialLabel } = Astro.props;
---
<figure class:list={["shot", "not-content", { compact: !src }]}>
  {!src && (
    <p class="line">
      <span>📷 화면 안내: {caption}</span>
      {officialUrl && (
        <a class="official" href={officialUrl} target="_blank" rel="noopener noreferrer">{officialLabel ?? '공식 도움말에서 이 화면 보기'} ↗</a>
      )}
    </p>
  )}
  {src && <div class="head">
    <Illustration name="media" size={28} />
    <p class="title">이 단계에서 보게 될 화면</p>
  </div>}
  {src && <img class="img" src={src} alt={alt ?? caption} loading="lazy" />}
  {src && <figcaption class="cap">{caption}</figcaption>}
  {src && officialUrl && (
    <a class="official" href={officialUrl} target="_blank" rel="noopener noreferrer">
      {officialLabel ?? '공식 도움말에서 이 화면 보기'} ↗
    </a>
  )}
  {src && <p class="note">실제 화면은 서비스 업데이트에 따라 다를 수 있어요</p>}
</figure>

<style>
  .shot {
    margin: 1.5rem 0;
    padding: 0.85rem 1rem 0.9rem;
    display: flex; flex-direction: column; align-items: flex-start; gap: 0.35rem;
    border: 1px solid var(--sl-color-gray-5);
    border-left: 4px solid var(--ai-coral);
    border-radius: 4px 14px 14px 4px;
    background: var(--ai-card-tint);
    text-align: left;
  }
  .shot.compact { margin: 1rem 0; padding: 0.5rem 0.85rem; gap: 0; border-radius: 4px 10px 10px 4px; }
  .line { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.1rem 0.75rem; font-size: var(--sl-text-sm); line-height: 1.55; color: var(--sl-color-gray-2); }
  .line span { overflow-wrap: anywhere; }
  .head { display: flex; align-items: center; gap: 0.5rem; }
  .head :global(svg) { flex: none; }
  .title { margin: 0; font-size: var(--sl-text-xs); font-weight: 700; color: var(--sl-color-gray-3); letter-spacing: 0.02em; }
  .img { display: block; max-width: 100%; height: auto; margin: 0.25rem 0; border-radius: 10px; border: 1px solid var(--sl-color-gray-5); }
  .cap { margin: 0; color: var(--sl-color-white); font-size: var(--sl-text-base); line-height: 1.6; overflow-wrap: anywhere; }
  .official { font-size: var(--sl-text-sm); font-weight: 600; color: var(--sl-color-accent-high); text-decoration: none; overflow-wrap: anywhere; }
  .official:hover { text-decoration: underline; }
  .note { margin: 0; color: var(--sl-color-gray-3); font-size: var(--sl-text-xs); }
</style>
